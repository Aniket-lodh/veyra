{
  "name": "@aniket-lodh/veyra-sdk",
  "version": "0.2.0",
  "description": "Lightweight, zero-dependency TypeScript and Node.js SDK for the Veyra Distributed Execution Platform",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs && tsc -p tsconfig.test.json && node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "veyra-sdk",
    "queue",
    "distributed-systems",
    "job-queue",
    "workers",
    "orchestration"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniket-lodh/veyra.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/Aniket-lodh/veyra#readme",
  "bugs": {
    "url": "https://github.com/Aniket-lodh/veyra/issues"
  },
  "license": "Apache-2.0"
}
