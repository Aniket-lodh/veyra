{
  "name": "@aniket-lodh/veyra-sdk",
  "version": "0.1.1",
  "description": "Lightweight TypeScript and Node.js SDK for Veyra Distributed Execution Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "veyra",
    "queue",
    "distributed-systems",
    "job-queue",
    "workers",
    "orchestration"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniket-lodh/veyra.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/Aniket-lodh/veyra#readme",
  "bugs": {
    "url": "https://github.com/Aniket-lodh/veyra/issues"
  },
  "license": "Apache-2.0"
}
