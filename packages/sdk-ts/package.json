{
  "name": "@veyra/sdk",
  "version": "0.1.0",
  "description": "Lightweight TypeScript and Node.js SDK for Veyra Distributed Execution Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "veyra",
    "queue",
    "distributed-systems",
    "job-queue",
    "workers",
    "orchestration"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniket-lodh/veyra.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/Aniket-lodh/veyra#readme",
  "bugs": {
    "url": "https://github.com/Aniket-lodh/veyra/issues"
  },
  "license": "Apache-2.0"
}
