# Veyra API configuration. Copy to .env and adjust. Never commit .env.
#
# The API loads .env from its working directory at startup. Environment variables
# set by the shell or Docker take precedence over the file.

# development | production. Development mounts Swagger at /swagger and uses text logs.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# HTTP port the API listens on.
PORT=8080

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=veyra
DB_PASSWORD=veyra
DB_NAME=veyra
# disable | require | verify-full (use verify-full in production)
DB_SSLMODE=disable

# --- Background loops (optional, defaults shown) ---
# How often the stale-worker sweeper runs.
VEYRA_SWEEPER_INTERVAL_SECONDS=10
# How often the retry scheduler promotes due retries, and how many rows per tick.
VEYRA_RETRY_INTERVAL_SECONDS=5
VEYRA_RETRY_BATCH_LIMIT=256
# How often the reclaim driver requeues expired leases, and how many rows per tick.
VEYRA_RECLAIM_INTERVAL_SECONDS=10
VEYRA_RECLAIM_BATCH_LIMIT=100
