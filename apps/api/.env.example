# Veyra API configuration. Copy to .env and adjust. Never commit .env.

# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
PORT=8080

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=veyra
DB_PASSWORD=veyra
DB_NAME=veyra
# disable | require | verify-full
DB_SSLMODE=disable

# --- Background loops (defaults shown) ---
VEYRA_SWEEPER_INTERVAL_SECONDS=10
VEYRA_RETRY_INTERVAL_SECONDS=5
VEYRA_RETRY_BATCH_LIMIT=256
VEYRA_RECLAIM_INTERVAL_SECONDS=10
VEYRA_RECLAIM_BATCH_LIMIT=100
