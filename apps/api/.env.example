# Veyra API configuration. Copy to .env and adjust. Never commit .env.

# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
PORT=8008

# --- Debug Endpoints ---
# false | true (defaults to true in development, false in production)
ENABLE_DEBUG_ENDPOINTS=false

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=veyra
DB_PASSWORD=veyra
DB_NAME=veyra
# disable | require | verify-full
DB_SSLMODE=disable

# --- Background loops (defaults shown) ---
VEYRA_SWEEPER_INTERVAL_SECONDS=10
VEYRA_RETRY_INTERVAL_SECONDS=5
VEYRA_RETRY_BATCH_LIMIT=256
VEYRA_RECLAIM_INTERVAL_SECONDS=10
VEYRA_RECLAIM_BATCH_LIMIT=100

# --- Completion Webhooks ---
VEYRA_CALLBACK_INTERVAL_SECONDS=2
VEYRA_CALLBACK_BATCH_LIMIT=50
VEYRA_CALLBACK_TIMEOUT_SECONDS=10
VEYRA_CALLBACK_CONCURRENCY=25
# Optional HMAC-SHA256 secret for signing webhook payloads with X-Veyra-Signature header
VEYRA_CALLBACK_SECRET=
