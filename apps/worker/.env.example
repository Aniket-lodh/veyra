# Copy to .env. Never commit .env.

APP_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=veyra
DB_PASSWORD=veyra
DB_NAME=veyra
DB_SSLMODE=disable

VEYRA_WORKER_QUEUES=default
VEYRA_WORKER_FAILURE_PERCENT=20

# SMTP (optional). Never put credentials in job payloads.
# VEYRA_SMTP_HOST=smtp.example.com
# VEYRA_SMTP_PORT=587
# VEYRA_SMTP_USERNAME=
# VEYRA_SMTP_PASSWORD=
# VEYRA_SMTP_FROM=noreply@example.com
# VEYRA_SMTP_TLS=starttls
