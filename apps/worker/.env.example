# Veyra worker configuration. Copy to .env and adjust. Never commit .env.
#
# The worker loads .env from its working directory at startup. Environment variables
# set by the shell or Docker take precedence over the file.

APP_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
# Either set the full URL, or the DB_* variables below. The URL takes precedence.
# VEYRA_WORKER_DATABASE_URL=postgres://veyra:veyra@localhost:5432/veyra?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=veyra
DB_PASSWORD=veyra
DB_NAME=veyra
DB_SSLMODE=disable

# Comma-separated queues this worker dequeues from.
VEYRA_WORKER_QUEUES=default
# Simulated failure rate for the noop handler, 0 to 100. Use 80 for retry-storm tests.
VEYRA_WORKER_FAILURE_PERCENT=20

# --- send_email SMTP (optional) ---
# Leave VEYRA_SMTP_HOST empty to disable delivery. send_email jobs then fail with smtp_config.
# Credentials are read from the worker environment only. Never put them in job payloads.
# VEYRA_SMTP_HOST=smtp.example.com
# VEYRA_SMTP_PORT=587
# VEYRA_SMTP_USERNAME=
# VEYRA_SMTP_PASSWORD=
# VEYRA_SMTP_FROM=noreply@example.com
# starttls | tls | none
# VEYRA_SMTP_TLS=starttls
