# Operator console configuration. Copy to .env.local and adjust. Never commit .env files.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# Where `pnpm dev` proxies API calls. Default: http://localhost:8080.
# Use http://localhost:8008 when the API runs through docker compose.
VITE_API_PROXY_TARGET=http://localhost:8008

# Optional. When set, the header shows an uptime badge linking to this status page.
# VITE_STATUS_PAGE_URL=https://status.example.com/endpoints/veyra-api
# VITE_STATUS_BADGE_URL=https://status.example.com/api/v1/endpoints/veyra-api/uptimes/24h/badge.svg
