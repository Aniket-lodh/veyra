# Veyra compose env. Copy to .env in this directory to override the defaults
# baked into docker-compose.yml. Compose autoloads this file on `up`.
#
# NEVER commit .env. It is the per-deployment secrets file.

# --- credentials ---
POSTGRES_USER=veyra
POSTGRES_PASSWORD=veyra
POSTGRES_DB=veyra

# --- runtime env ---
# APP_ENV switches the logger between text (dev) and JSON (anything else).
APP_ENV=development
LOG_LEVEL=info

# Comma-separated. Each worker container subscribes to these queues. Override
# per-deployment if you split workloads across queues.
VEYRA_WORKER_QUEUES=default

# --- send_email SMTP (worker only; never put secrets in job payloads) ---
# Leave VEYRA_SMTP_HOST empty to disable delivery; jobs fail with smtp_config.
# VEYRA_SMTP_HOST=smtp.example.com
# VEYRA_SMTP_PORT=587
# VEYRA_SMTP_USERNAME=
# VEYRA_SMTP_PASSWORD=
# VEYRA_SMTP_FROM=noreply@example.com
# VEYRA_SMTP_TLS=starttls   # starttls | tls | none
