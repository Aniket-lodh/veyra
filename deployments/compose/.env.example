# Copy to .env. Never commit .env.

POSTGRES_USER=veyra
POSTGRES_PASSWORD=veyra
POSTGRES_DB=veyra

APP_ENV=development
LOG_LEVEL=info

VEYRA_WORKER_QUEUES=default

# Worker SMTP (optional). Leave host empty to disable send_email.
# VEYRA_SMTP_HOST=smtp.example.com
# VEYRA_SMTP_PORT=587
# VEYRA_SMTP_USERNAME=
# VEYRA_SMTP_PASSWORD=
# VEYRA_SMTP_FROM=noreply@example.com
# VEYRA_SMTP_TLS=starttls
